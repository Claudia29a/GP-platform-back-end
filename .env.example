# Copy to .env and fill in.
# The OAuth client ID from Google Cloud Console (public, not a secret).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Comma-separated e-mail addresses of practice staff; everyone else is a patient.
GP_EMAILS=gp@example.com
ASSISTANT_EMAILS=assistant@example.com
# Encrypt and hash personal data in the local databases. These two are for your laptop only; make new ones
# with `openssl rand -base64 32` for any other environment, and keep them: without its key the data is lost.
INTAKE_DATA_KEY=bG9jYWwtb25seS1pbnRha2Uta2V5LTAxMjM0NTY3ODk=
ACCOUNT_DATA_KEY=bG9jYWwtb25seS1hY2NvdW50LWtleS0wMTIzNDU2Nzg=
